# ---------------------------------------------------------------------------
# Pulsar v0 — Stellar TESTNET only. Never put mainnet keys or real funds here.
# Copy to .env and fill in 3 generated keypairs (see README: "Generate keys").
# NEVER commit .env — it contains secret keys. Demo keys only.
# NOTE: values are quoted so this file is valid for both dotenv and `source`.
# ---------------------------------------------------------------------------

# --- Demo identities (generated with `node scripts/gen-keys.mjs`) ----------
PLAYER_A_PUBLIC="G..."
PLAYER_A_SECRET="S..."
PLAYER_B_PUBLIC="G..."
PLAYER_B_SECRET="S..."
OPERATOR_PUBLIC="G..."
OPERATOR_SECRET="S..."

# --- Network (Stellar Testnet) ----------------------------------------------
NETWORK="testnet"
HORIZON_URL="https://horizon-testnet.stellar.org"
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# --- Sequencer ---------------------------------------------------------------
PORT="8787"

# --- Web ---------------------------------------------------------------------
# Ports are configurable; 3000/8787 are the defaults. Override locally if a
# port is already taken (WEB_PORT only affects the Next.js dev server).
NEXT_PUBLIC_SEQUENCER_URL="http://localhost:8787"
WEB_PORT="3000"

# --- Contract IDs ------------------------------------------------------------
# Left empty on purpose: ./scripts/deploy.sh deploys fresh instances bound to
# YOUR operator key and fills these in. The reference deployment used for the
# demo video / screenshots is:
#   SESSION_REGISTRY_ID="CDVG3ZYPHW5AJOWZHLZDW6XBUDR3WGYSIT34YDPBDCW5TUAII72WR4JH"
#   SLOW_TICTACTOE_ID="CCCR4BS4XH7VQ6MP2PNDPPUWMTESFEF4TW65ZDNQ73O7PKOI6EHCX556"
# (Also listed in README.md — do not reuse them: their operator is not your key.)
SESSION_REGISTRY_ID=""
SLOW_TICTACTOE_ID=""
